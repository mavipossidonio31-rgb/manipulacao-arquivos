def criar_arquivo():
    # o "with"  fecha o arquivo automaticamente
    # o "pen()" funcao para leitura ou escrita de arquivos
    with open ("aluno.txt", "w" , encoding="utf-8") as arquivo:
        arquivo.write("maria\n")
        arquivo.write("manu\n")
        arquivo.write("luiza\n")

